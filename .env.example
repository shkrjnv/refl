# Copy to .env.local (untracked) for `just dev`. Do not commit real secrets.

# Optional Telegram bot. Without a token, Telegram sign-in stays disabled.
TELEGRAM_BOT_TOKEN=
# Bot username without @; enables the official Login Widget in the browser.
TELEGRAM_BOT_USERNAME=
# Bootstrap admin Telegram user id and the private chat that receives
# approval requests. ADMIN_TELEGRAM_CHAT_ID falls back to ADMIN_TELEGRAM_ID.
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_CHAT_ID=

# Optional Vite overrides. `just dev` derives VITE_TELEGRAM_BOT_ID from the
# token prefix and copies VITE_TELEGRAM_BOT_USERNAME from TELEGRAM_BOT_USERNAME.
VITE_TELEGRAM_BOT_ID=
VITE_TELEGRAM_BOT_USERNAME=

# Optional bootstrap admin email.
ADMIN_EMAIL=
