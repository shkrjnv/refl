# Topic «Articles»: explanations, one record per target, depth and language
# (docs/02, «Объяснение»).
let s = import "../lib/schema.ncl" in
# en is the source text and final; uz and ru wait for the author's review.
let final = { status = "reviewed" } in
let draft = { status = "draft" } in
let kc = fun target => { kind = "kc", id = target } in
let mis = fun target => { kind = "misconception", id = target } in
# A micro-explanation shown right after the error: at most two sentences.
let micro = fun misconception language text =>
  {
    # en.mis.article.x → expl.mis.article.x.<lang>
    id = "expl.%{std.string.substring 3 (std.string.length misconception) misconception}.%{language}",
    target = mis misconception,
    depth = "short",
    lang = language,
    body = text,
    review = if language == "en" then final else draft,
  }
in
let countability = "en.gram.noun.countability" in
let a_an = "en.gram.article.a-an-sound" in
let zero = "en.gram.article.zero-general" in
{
  explanations = [
    # Countable and uncountable nouns.
    {
      id = "expl.noun.countability.short.en",
      target = kc countability,
      depth = "short",
      lang = "en",
      body = "**A book**, **two books**: you can count books. **Water**, **advice**: you can't count them, so they take no *a/an* and no *-s*. Say *some water*, *some advice*.",
      examples = [{ text = "There are three chairs in the room." }, { text = "Can I have some water?" }],
      review = final,
    },
    {
      id = "expl.noun.countability.short.uz",
      target = kc countability,
      depth = "short",
      lang = "uz",
      body = "**A book**, **two books**: kitoblarni sanash mumkin. **Water**, **advice**: ularni sanab boʻlmaydi, shuning uchun oldiga *a/an* qoʻyilmaydi va oxiriga *-s* qoʻshilmaydi: *some water*, *some advice*.",
      l1_contrast = "Oʻzbek tilida sondan keyin ot birlikda turadi: *uchta stul*. Inglizchada sondan keyin koʻplik shakli keladi: *three chairs*. *Maslahat* oʻzbekchada sanaladi, inglizcha *advice* esa sanalmaydi: *an advice* emas, *some advice*.",
      examples = [{ text = "There are three chairs in the room." }, { text = "Can I have some water?" }],
      review = draft,
    },
    # a or an by sound.
    {
      id = "expl.article.a-an-sound.short.en",
      target = kc a_an,
      depth = "short",
      lang = "en",
      body = "*a* cat, *an* apple, *an* hour, *a* university. Listen to the first sound, not the first letter: *an* before a vowel sound, *a* before a consonant sound. *Hour* starts with the sound /aʊ/, *university* with /j/.",
      examples = [{ text = "I ate an apple." }, { text = "We waited an hour." }],
      review = final,
    },
    {
      id = "expl.article.a-an-sound.short.ru",
      target = kc a_an,
      depth = "short",
      lang = "ru",
      body = "*a* cat, *an* apple, *an* hour, *a* university. Смотрите на первый звук слова, а не на букву: *an* перед гласным звуком, *a* перед согласным. *Hour* начинается со звука /aʊ/, *university* — со звука /j/.",
      l1_contrast = "Похоже на русские «о» и «об»: «о доме», но «об окне». Так же и здесь: форма зависит от первого звука следующего слова.",
      examples = [{ text = "I ate an apple." }, { text = "We waited an hour." }],
      review = draft,
    },
    {
      id = "expl.article.a-an-sound.short.uz",
      target = kc a_an,
      depth = "short",
      lang = "uz",
      body = "*a* cat, *an* apple, *an* hour, *a* university. Birinchi harfga emas, birinchi tovushga qarang: unli tovushdan oldin *an*, undosh tovushdan oldin *a*. *Hour* /aʊ/ tovushi bilan, *university* esa /j/ tovushi bilan boshlanadi.",
      l1_contrast = "Oʻzbekchada *bir* soʻzi hech qachon oʻzgarmaydi: *bir olma*, *bir soat*. Inglizchada esa *a* yoki *an* keyingi soʻzning birinchi tovushiga qarab tanlanadi.",
      examples = [{ text = "I ate an apple." }, { text = "We waited an hour." }],
      review = draft,
    },
    # No article for things in general.
    {
      id = "expl.article.zero-general.short.en",
      target = kc zero,
      depth = "short",
      lang = "en",
      body = "**Cats** are clever. **Water** is important. When we talk about things in general, plural and uncountable nouns take no article. *The cats* means particular cats we already know.",
      examples = [{ text = "I like music." }, { text = "Dogs are friendly." }],
      review = final,
    },
    {
      id = "expl.article.zero-general.short.ru",
      target = kc zero,
      depth = "short",
      lang = "ru",
      body = "**Cats** are clever. **Water** is important. Когда речь о предметах вообще, перед множественным числом и неисчисляемыми существительными артикля нет. *The cats* — это конкретные кошки, о которых уже знают.",
      l1_contrast = "По-русски «Я люблю кошек» — это и о кошках вообще, и о своих кошках. В английском разница видна: *I love cats* — вообще, *I love the cats* — вот этих.",
      examples = [{ text = "I like music." }, { text = "Dogs are friendly." }],
      review = draft,
    },
    {
      id = "expl.article.zero-general.short.uz",
      target = kc zero,
      depth = "short",
      lang = "uz",
      body = "**Cats** are clever. **Water** is important. Narsalar haqida umuman gapirganda koʻplikdagi va sanalmaydigan otlar oldiga artikl qoʻyilmaydi. *The cats* esa oldindan tanish boʻlgan aniq mushuklar.",
      l1_contrast = "Oʻzbekcha *Men mushuklarni yaxshi koʻraman* umuman mushuklar haqida ham, oʻzingizning mushuklaringiz haqida ham boʻlishi mumkin. Inglizchada umumiy gapda *the* qoʻyilmaydi: *I love cats*.",
      examples = [{ text = "I like music." }, { text = "Dogs are friendly." }],
      review = draft,
    },
    # Micro-explanations of the misconceptions added with the unit.
    micro "en.mis.article.a-for-known" "en" "Once you've said *a dog*, the dog is known: next time it's ***the** dog*.",
    micro "en.mis.article.a-for-known" "ru" "Если уже сказали *a dog*, собака стала известной: дальше — ***the** dog*.",
    micro "en.mis.article.a-for-known" "uz" "*a dog* deb aytgandan keyin it tanish boʻladi: keyingi safar ***the** dog*.",
    micro "en.mis.article.a-always" "en" "Before a vowel sound, *a* becomes *an*: ***an** apple*, ***an** egg*. It's easier to say.",
    micro "en.mis.article.a-always" "ru" "Перед гласным звуком *a* превращается в *an*: ***an** apple*, ***an** egg*. Так легче произносить.",
    micro "en.mis.article.a-always" "uz" "Unli tovushdan oldin *a* oʻrniga *an* keladi: ***an** apple*, ***an** egg*. Shunday aytish osonroq.",
    micro "en.mis.article.an-by-letter" "en" "*a* or *an* depends on the first sound, not the letter: ***an** hour* (the h is silent), ***a** university* (it starts with /j/).",
    micro "en.mis.article.an-by-letter" "ru" "*a* или *an* зависит от первого звука, а не от буквы: ***an** hour* (h не читается), ***a** university* (начинается со звука /j/).",
    micro "en.mis.article.an-by-letter" "uz" "*a* yoki *an* birinchi harfga emas, birinchi tovushga bogʻliq: ***an** hour* (h oʻqilmaydi), ***a** university* (/j/ tovushi bilan boshlanadi).",
    micro "en.mis.noun.a-with-uncountable" "en" "*Advice*, *information* and *furniture* can't be counted in English, so they take no *a/an*: ***some** advice*, not *an advice*.",
    micro "en.mis.noun.a-with-uncountable" "ru" "*Advice*, *information* и *furniture* в английском не считаются, поэтому без *a/an*: ***some** advice*, а не *an advice*.",
    micro "en.mis.noun.a-with-uncountable" "uz" "Inglizchada *advice*, *information* va *furniture* sanalmaydi, shuning uchun *a/an* qoʻyilmaydi: *an advice* emas, ***some** advice*.",
    micro "en.mis.noun.plural-uncountable" "en" "Uncountable nouns have no plural: *some information*, not *informations*.",
    micro "en.mis.noun.plural-uncountable" "ru" "У неисчисляемых существительных нет множественного числа: *some information*, а не *informations*.",
    micro "en.mis.noun.plural-uncountable" "uz" "Sanalmaydigan otlarning koʻplik shakli yoʻq: *informations* emas, *some information*.",
    micro "en.mis.noun.singular-after-number" "en" "After a number bigger than one, the noun is plural: *three chair**s***, *two apple**s***.",
    micro "en.mis.noun.singular-after-number" "ru" "После числа больше одного существительное стоит во множественном числе: *three chair**s***, *two apple**s***. Не как в русском «три стула».",
    micro "en.mis.noun.singular-after-number" "uz" "Birdan katta sondan keyin ot koʻplikda boʻladi: *three chair**s***, *two apple**s***. Oʻzbekchadagi *uchta stul* kabi emas.",
    micro "en.mis.article.the-for-general" "en" "When you talk about things in general, don't use *the*: ***Life** is short*, *I like **music***.",
    micro "en.mis.article.the-for-general" "ru" "Когда говорим о чём-то вообще, *the* не нужен: ***Life** is short*, *I like **music***.",
    micro "en.mis.article.the-for-general" "uz" "Umuman biror narsa haqida gapirganda *the* kerak emas: ***Life** is short*, *I like **music***.",
    micro "en.mis.article.a-with-plural" "en" "*a* means one, so it never goes with a plural: ***dogs***, not *a dogs*.",
    micro "en.mis.article.a-with-plural" "ru" "*a* значит «один», поэтому с множественным числом не ставится: ***dogs***, а не *a dogs*.",
    micro "en.mis.article.a-with-plural" "uz" "*a* «bitta» degani, shuning uchun koʻplik bilan ishlatilmaydi: *a dogs* emas, ***dogs***.",
    {
      id = "expl.article.first-mention.short.ru",
      target = { kind = "kc", id = "en.gram.article.first-mention" },
      depth = "short",
      lang = "ru",
      body = "I have **a** cat. **The** cat is black. Когда предмет упоминается впервые, перед ним ставится *a* или *an*: собеседник его ещё не знает.",
      l1_contrast = "В русском артиклей нет: «Я купил книгу» не говорит, новая это книга или уже известная. В английском это видно всегда: I bought **a** book.",
      examples = [{ text = "I have a cat." }, { text = "She bought an umbrella." }],
      review = draft,
    },
    {
      id = "expl.article.first-mention.short.uz",
      target = { kind = "kc", id = "en.gram.article.first-mention" },
      depth = "short",
      lang = "uz",
      body = "I have **a** cat. **The** cat is black. Biror narsa birinchi marta tilga olinganda oldiga *a* yoki *an* qoʻyiladi: tinglovchi uni hali bilmaydi.",
      l1_contrast = "Oʻzbekchada yangi narsani *bir* bilan aytish mumkin, lekin shart emas: *mushugim bor*. Inglizchada *a* majburiy: *I have cat* emas, *I have a cat*.",
      examples = [{ text = "I have a cat." }, { text = "She bought an umbrella." }],
      review = draft,
    },
    {
      id = "expl.article.first-mention.short.en",
      target = { kind = "kc", id = "en.gram.article.first-mention" },
      depth = "short",
      lang = "en",
      body = "I have **a** cat. **The** cat is black. The first time we mention a thing, we say *a* or *an*: the listener doesn't know it yet.",
      examples = [{ text = "I have a cat." }, { text = "She bought an umbrella." }],
      review = final,
    },
    {
      id = "expl.article.second-mention.short.ru",
      target = { kind = "kc", id = "en.gram.article.second-mention" },
      depth = "short",
      lang = "ru",
      body = "I bought **a** book. **The** book is about space. После первого упоминания предмет уже известен, поэтому перед ним *the*. *The* ставится и тогда, когда обоим понятно, о чём речь: *Close the door*.",
      l1_contrast = "В русском эту разницу передаёт порядок слов: «В комнату вошёл мужчина» — новый человек, «Мужчина вошёл в комнату» — уже знакомый. В английском — артикль: *A man came in* / *The man came in*.",
      examples = [{ text = "I have a dog. The dog is black." }, { text = "A man and a woman came in. The woman sat down." }],
      review = draft,
    },
    {
      id = "expl.article.second-mention.short.uz",
      target = { kind = "kc", id = "en.gram.article.second-mention" },
      depth = "short",
      lang = "uz",
      body = "I bought **a** book. **The** book is about space. Narsa bir marta tilga olingandan keyin tanish boʻladi, shuning uchun oldiga *the* qoʻyiladi. Ikkala suhbatdosh nima haqida gap ketayotganini bilsa ham *the* ishlatiladi: *Close the door*.",
      l1_contrast = "Oʻzbekchada tanish narsani koʻpincha *-ni* qoʻshimchasi koʻrsatadi: *kitob oldim* — qandaydir kitob, *kitobni oldim* — oʻsha kitob. Inglizchada buni *the* bildiradi: *I took the book*.",
      examples = [{ text = "I have a dog. The dog is black." }, { text = "A man and a woman came in. The woman sat down." }],
      review = draft,
    },
    {
      id = "expl.article.second-mention.short.en",
      target = { kind = "kc", id = "en.gram.article.second-mention" },
      depth = "short",
      lang = "en",
      body = "I bought **a** book. **The** book is about space. After the first mention the thing is known, so it takes *the*. *The* also goes with things both people already know: *Close the door*.",
      examples = [{ text = "I have a dog. The dog is black." }, { text = "A man and a woman came in. The woman sat down." }],
      review = final,
    },
    {
      id = "expl.noun.countability.short.ru",
      target = { kind = "kc", id = "en.gram.noun.countability" },
      depth = "short",
      lang = "ru",
      body = "**A book**, **two books**: книги можно посчитать. **Water**, **advice**: их не считают, поэтому без *a/an* и без *-s*: *some water*, *some advice*.",
      l1_contrast = "По-русски «советы» и «новости» — во множественном числе, а английские *advice* и *news* не считаются: не *advices*, а *some advice*. После числа в английском всегда множественное число: *three chairs*, хотя по-русски «три стула».",
      examples = [{ text = "There are three chairs in the room." }, { text = "Can I have some water?" }],
      review = draft,
    },
    micro "en.mis.article.omission-l1" "en" "A singular countable noun needs an article: not *I have cat*, but *I have **a** cat*.",
    micro "en.mis.article.omission-l1" "ru" "Перед одним исчисляемым предметом нужен артикль: не *I have cat*, а *I have **a** cat*. В русском артиклей нет, поэтому его легко пропустить.",
    micro "en.mis.article.omission-l1" "uz" "Bitta sanaladigan narsa oldida artikl kerak: *I have cat* emas, *I have **a** cat*. Oʻzbek tilida artikl yoʻq, shuning uchun uni tushirib qoldirish oson.",
    micro "en.mis.article.the-for-new" "en" "*the* is for a thing the listener already knows. A new thing comes with *a* or *an*: *Look, there's **a** bird!*",
    micro "en.mis.article.the-for-new" "ru" "*the* — для того, что собеседник уже знает. Новый предмет вводится через *a* или *an*: *Look, there's **a** bird!*",
    micro "en.mis.article.the-for-new" "uz" "*the* tinglovchi allaqachon biladigan narsa uchun. Yangi narsa *a* yoki *an* bilan aytiladi: *Look, there's **a** bird!*",
  ],
} | s.File
