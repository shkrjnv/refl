{"id":"book.aesop-lion-mouse","version":"37fd20d3f6919f1f8b09f71fa6256e26fb51343d5d38cb9a08fd69eae81c29d8","title":{"uz":"Sher va sichqon","ru":"Лев и мышь","en":"The Lion and the Mouse"},"level":"A1","license":"public-domain","source":"Aesop's Fables, translated by George Fyler Townsend (1867), public domain; A1 retelling by the refl author","chapters":[{"id":"chapter.aesop-lion-mouse.1","title":{"uz":"Sher va sichqon","ru":"Лев и мышь","en":"The Lion and the Mouse"},"paragraphs":[{"id":"para.aesop-lion-mouse.1.1","sentences":[{"id":"sentence.aesop-lion-mouse.1.1.1","text":"A lion is in his house.","tokens":[{"id":"token.aesop-lion-mouse.1.1.1.1","text":"A","lemma":"a","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.1.2","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.1.3","text":"is","lemma":"is","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.1.4","text":"in","lemma":"in","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.1.5","text":"his","lemma":"his","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.1.6","text":"house","lemma":"house","lexeme_id":"en.lex.house.building","sense_ids":[],"kc_ids":["en.gram.article.first-mention","en.gram.noun.countability"]}]},{"id":"sentence.aesop-lion-mouse.1.1.2","text":"A small mouse runs over the lion's face.","tokens":[{"id":"token.aesop-lion-mouse.1.1.2.1","text":"A","lemma":"a","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.2","text":"small","lemma":"small","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.3","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.4","text":"runs","lemma":"runs","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.5","text":"over","lemma":"over","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.6","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.7","text":"lion's","lemma":"lion's","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.2.8","text":"face","lemma":"face","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.1.3","text":"The lion is angry.","tokens":[{"id":"token.aesop-lion-mouse.1.1.3.1","text":"The","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.3.2","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.3.3","text":"is","lemma":"is","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.3.4","text":"angry","lemma":"angry","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.1.4","text":"He catches the mouse.","tokens":[{"id":"token.aesop-lion-mouse.1.1.4.1","text":"He","lemma":"he","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.4.2","text":"catches","lemma":"catches","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.4.3","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.1.4.4","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]}]}]},{"id":"para.aesop-lion-mouse.1.2","sentences":[{"id":"sentence.aesop-lion-mouse.1.2.1","text":"\"Please let me go,\" says the mouse.","tokens":[{"id":"token.aesop-lion-mouse.1.2.1.1","text":"Please","lemma":"please","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.1.2","text":"let","lemma":"let","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.1.3","text":"me","lemma":"me","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.1.4","text":"go","lemma":"go","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.1.5","text":"says","lemma":"says","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.1.6","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.1.7","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.2.2","text":"\"One day I can help you.\"","tokens":[{"id":"token.aesop-lion-mouse.1.2.2.1","text":"One","lemma":"one","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.2.2","text":"day","lemma":"day","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.2.3","text":"I","lemma":"i","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.2.4","text":"can","lemma":"can","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.2.5","text":"help","lemma":"help","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.2.2.6","text":"you","lemma":"you","sense_ids":[],"kc_ids":[]}]}]},{"id":"para.aesop-lion-mouse.1.3","sentences":[{"id":"sentence.aesop-lion-mouse.1.3.1","text":"The lion laughs.","tokens":[{"id":"token.aesop-lion-mouse.1.3.1.1","text":"The","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.1.2","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.1.3","text":"laughs","lemma":"laughs","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.3.2","text":"\"You are small.","tokens":[{"id":"token.aesop-lion-mouse.1.3.2.1","text":"You","lemma":"you","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.2.2","text":"are","lemma":"are","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.2.3","text":"small","lemma":"small","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.3.3","text":"How can you help me?\"","tokens":[{"id":"token.aesop-lion-mouse.1.3.3.1","text":"How","lemma":"how","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.3.2","text":"can","lemma":"can","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.3.3","text":"you","lemma":"you","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.3.4","text":"help","lemma":"help","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.3.5","text":"me","lemma":"me","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.3.4","text":"But he lets the mouse go.","tokens":[{"id":"token.aesop-lion-mouse.1.3.4.1","text":"But","lemma":"but","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.4.2","text":"he","lemma":"he","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.4.3","text":"lets","lemma":"lets","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.4.4","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.4.5","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.3.4.6","text":"go","lemma":"go","sense_ids":[],"kc_ids":[]}]}]},{"id":"para.aesop-lion-mouse.1.4","sentences":[{"id":"sentence.aesop-lion-mouse.1.4.1","text":"Later, some men catch the lion.","tokens":[{"id":"token.aesop-lion-mouse.1.4.1.1","text":"Later","lemma":"later","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.1.2","text":"some","lemma":"some","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.1.3","text":"men","lemma":"men","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.1.4","text":"catch","lemma":"catch","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.1.5","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.1.6","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.4.2","text":"They tie him with a strong rope.","tokens":[{"id":"token.aesop-lion-mouse.1.4.2.1","text":"They","lemma":"they","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.2.2","text":"tie","lemma":"tie","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.2.3","text":"him","lemma":"him","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.2.4","text":"with","lemma":"with","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.2.5","text":"a","lemma":"a","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.2.6","text":"strong","lemma":"strong","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.2.7","text":"rope","lemma":"rope","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.4.3","text":"The lion roars.","tokens":[{"id":"token.aesop-lion-mouse.1.4.3.1","text":"The","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.3.2","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.3.3","text":"roars","lemma":"roars","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.4.4","text":"The mouse hears him.","tokens":[{"id":"token.aesop-lion-mouse.1.4.4.1","text":"The","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.4.2","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.4.3","text":"hears","lemma":"hears","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.4.4","text":"him","lemma":"him","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.4.5","text":"He runs to the lion.","tokens":[{"id":"token.aesop-lion-mouse.1.4.5.1","text":"He","lemma":"he","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.5.2","text":"runs","lemma":"runs","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.5.3","text":"to","lemma":"to","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.5.4","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.4.5.5","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]}]}]},{"id":"para.aesop-lion-mouse.1.5","sentences":[{"id":"sentence.aesop-lion-mouse.1.5.1","text":"\"Do not worry,\" says the mouse.","tokens":[{"id":"token.aesop-lion-mouse.1.5.1.1","text":"Do","lemma":"do","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.1.2","text":"not","lemma":"not","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.1.3","text":"worry","lemma":"worry","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.1.4","text":"says","lemma":"says","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.1.5","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.1.6","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.5.2","text":"\"I can help you.\"","tokens":[{"id":"token.aesop-lion-mouse.1.5.2.1","text":"I","lemma":"i","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.2.2","text":"can","lemma":"can","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.2.3","text":"help","lemma":"help","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.5.2.4","text":"you","lemma":"you","sense_ids":[],"kc_ids":[]}]}]},{"id":"para.aesop-lion-mouse.1.6","sentences":[{"id":"sentence.aesop-lion-mouse.1.6.1","text":"The mouse bites the rope.","tokens":[{"id":"token.aesop-lion-mouse.1.6.1.1","text":"The","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.1.2","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.1.3","text":"bites","lemma":"bites","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.1.4","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.1.5","text":"rope","lemma":"rope","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.6.2","text":"He bites it again and again.","tokens":[{"id":"token.aesop-lion-mouse.1.6.2.1","text":"He","lemma":"he","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.2.2","text":"bites","lemma":"bites","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.2.3","text":"it","lemma":"it","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.2.4","text":"again","lemma":"again","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.2.5","text":"and","lemma":"and","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.2.6","text":"again","lemma":"again","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.6.3","text":"At last, the rope is open.","tokens":[{"id":"token.aesop-lion-mouse.1.6.3.1","text":"At","lemma":"at","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.3.2","text":"last","lemma":"last","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.3.3","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.3.4","text":"rope","lemma":"rope","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.3.5","text":"is","lemma":"is","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.3.6","text":"open","lemma":"open","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.6.4","text":"The lion is free.","tokens":[{"id":"token.aesop-lion-mouse.1.6.4.1","text":"The","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.4.2","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.4.3","text":"is","lemma":"is","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.6.4.4","text":"free","lemma":"free","sense_ids":[],"kc_ids":[]}]}]},{"id":"para.aesop-lion-mouse.1.7","sentences":[{"id":"sentence.aesop-lion-mouse.1.7.1","text":"\"Thank you, little mouse,\" says the lion.","tokens":[{"id":"token.aesop-lion-mouse.1.7.1.1","text":"Thank","lemma":"thank","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.7.1.2","text":"you","lemma":"you","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.7.1.3","text":"little","lemma":"little","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.7.1.4","text":"mouse","lemma":"mouse","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.7.1.5","text":"says","lemma":"says","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.7.1.6","text":"the","lemma":"the","sense_ids":[],"kc_ids":[]},{"id":"token.aesop-lion-mouse.1.7.1.7","text":"lion","lemma":"lion","sense_ids":[],"kc_ids":[]}]},{"id":"sentence.aesop-lion-mouse.1.7.2","text":"\"Now I know that a small friend can help a big lion.\"","tokens":[{"id":"token.aesop-lion-mouse.1.7.2.1","text":"Now","lemma":"now","sense_ids":[],"kc_ids":[]},{"id":"token